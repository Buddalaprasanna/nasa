# FIELD SHIFT - Environment Configuration
# Copy this file to .env:
# cp .env.example .env

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite default for local zero-config runs)
DATABASE_URL=sqlite:///./field_shift.db

# NASA Earth Observation Configuration
# NASA POWER is a public open science API (no key required for standard rate limits)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
NASA_POWER_DAILY_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# NASA Earthdata Login for direct NASA GPM IMERG GES DISC granules (Optional):
# Register free at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username_here
EARTHDATA_PASSWORD=your_earthdata_password_here

# Cache duration in seconds (24 hours default to minimize NASA API rate pressure)
CLIMATE_CACHE_TTL_SECONDS=86400
